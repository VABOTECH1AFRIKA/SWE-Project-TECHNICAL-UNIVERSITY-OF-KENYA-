# Server runtime configuration
DATABASE_PROVIDER=supabase
DB_PATH=

# Supabase server-side access
# SUPABASE_SERVICE_ROLE_KEY is SECRET and SERVER ONLY.
# NEVER EXPOSE IT TO THE CLIENT or put it in any VITE_* variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=studyhub-private

# Local/private storage fallback for SQLite development and tests
CONTENT_STORAGE_ROOT=

# Optional server-side Tutor provider selection. Defaults to the deterministic fake provider.
AI_PROVIDER=fake
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
